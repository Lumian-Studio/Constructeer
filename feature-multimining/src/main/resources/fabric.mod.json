{
	"schemaVersion": 1,
	"id": "constructeer-multimining",
	"version": "${version}",
	"name": "${name}",
	"description": "Increase your mining game TO THE MAX!!!!",
	"authors": [ "LumiaLights" ],
	"contact": {
		"homepage": "https://modrinth.com/mod/constructeer",
		"sources": "https://github.com/Lumian-Studio/constructeer"
	},
	"license": "MIT",
	"icon": "assets/constructeer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main":    [ "xyz.lumian.constructeer.multimining.CteerMultiMining"               ],
		"client":  [ "xyz.lumian.constructeer.multimining.client.CteerMultiMiningClient"  ],
		"modmenu": [ "xyz.lumian.constructeer.multimining.client.integration.ClothConfig" ]
	},
	"depends": {
		"fabricloader":       "${fabric_loader_version}",
		"minecraft":          "${minecraft_version}",
		"java":               ">=${java_version}",
		"fabric-api":         "${fabric_api_version}",
		"forgeconfigapiport": "${forge_config_api_port_version}",
		"constructeer-core":  "${version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/constructeer"
			},
			"parent": {
				"id":          "${mod_id}",
				"name":        "${mod_name}",
				"description": "${mod_desc}",
				"icon":        "assets/constructeer/icon-parent.png"
			}
		}
	}
}