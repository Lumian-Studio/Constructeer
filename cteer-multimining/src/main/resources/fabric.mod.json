{
	"schemaVersion": 1,
	"id": "constructeer",
	"version": "${version}",
	"name": "${name}",
	"description": "Step up your construction-game with all these new tools.",
	"authors": [ "LumiaLights" ],
	"contact": {
		"homepage": "https://modrinth.com/mod/constructeer",
		"sources": "https://github.com/Lumian-Studio/constructeer"
	},
	"license": "MIT",
	"icon": "assets/constructeer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [ "xyz.lumian.constructeer.ConstructeerMain" ],
		"client": [ "xyz.lumian.constructeer.client.ConstructeerClient" ],
		"fabric-datagen": [ "xyz.lumian.constructeer.client.data.ConstructeerData" ],
		"modmenu": [ "xyz.lumian.constructeer.client.integration.ClothConfig" ]
	},
	"mixins": [
		"constructeer.mixins.json",
		{
			"config": "constructeer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"forgeconfigapiport": "~21.11.1"
	}
}