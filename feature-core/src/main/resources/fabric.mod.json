{
	"schemaVersion": 1,
	"id": "constructeer-core",
	"version": "${version}",
	"name": "${name}",
	"description": "The backbone to all Constructeer feature modules.",
	"authors": [ "LumiaLights" ],
	"contact": {
		"homepage": "https://modrinth.com/mod/constructeer",
		"sources":  "https://github.com/Lumian-Studio/constructeer"
	},
	"license": "MIT",
	"icon": "assets/constructeer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main":           [ "xyz.lumian.constructeer.Constructeer"                    ],
		"client":         [ "xyz.lumian.constructeer.client.ConstructeerClient"       ],
		"fabric-datagen": [ "xyz.lumian.constructeer.client.data.ConstructeerDatagen" ]
	},
	"mixins": [
		"constructeer.mixins.json",
		{
			"environment": "client",
			"config":      "constructeer.client.mixins.json"
		}
	],
	"depends": {
		"fabricloader":       "${fabric_loader_version}",
		"minecraft":          "${minecraft_version}",
		"java":               ">=${java_version}",
		"fabric-api":         "${fabric_api_version}",
		"forgeconfigapiport": "${forge_config_api_port_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/constructeer"
			},
			"parent": {
				"id":          "${mod_id}",
				"name":        "${mod_name}",
				"description": "${mod_desc}",
				"icon":        "assets/constructeer/icon.png"
			}
		}
	}
}